{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "kora_size_guide": {
          "type": "kora_size_guide",
          "settings": {
            "label": "Size guide",
            "heading": "Find your size",
            "default_chart": "women-tops",
            "show_whatsapp_help": true,
            "show_without_size_option": false,
            "color_scheme": "scheme-1"
          }
        },
        "kora_whatsapp": {
          "type": "kora_whatsapp",
          "settings": {
            "label": "Order on WhatsApp",
            "message": "",
            "note": "Prefer to chat? We usually reply within a few hours."
          }
        },
        "kora_fabric_care": {
          "type": "kora_fabric_care",
          "settings": {
            "heading": "Fabric and care",
            "open_by_default": true
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping and exchanges",
            "icon": "truck",
            "content": "<p>Ships in 2 working days from Jaipur. Free shipping across India on orders over ₹1,499. Cash on delivery available.</p><p>Not the right size? Message us on WhatsApp within 7 days of delivery and we will arrange a pickup and send the new size.</p>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "kora_size_guide",
        "quantity_selector",
        "buy_buttons",
        "kora_whatsapp",
        "description",
        "kora_fabric_care",
        "shipping",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Pair it with",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
