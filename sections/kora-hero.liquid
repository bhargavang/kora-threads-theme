{%- comment -%}
  Kora Threads homepage hero.
  Split layout: copy on one side, image on the other. If no image is picked
  in the theme editor it falls back to the illustration shipped in assets,
  so a fresh install never shows an empty grey box.
{%- endcomment -%}
{{ 'section-kora-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign highlights = section.settings.highlights | split: ','
-%}

<div class="kora-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width kora-hero__inner kora-hero__inner--media-{{ section.settings.image_position }} section-{{ section.id }}-padding">
    <div class="kora-hero__content{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="kora-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="kora-hero__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="kora-hero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="kora-hero__buttons">
          {%- if section.settings.button_label_1 != blank -%}
            <a
              {% if section.settings.button_link_1 != blank %}
                href="{{ section.settings.button_link_1 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button button--primary"
            >
              {{- section.settings.button_label_1 | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a
              {% if section.settings.button_link_2 != blank %}
                href="{{ section.settings.button_link_2 }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button button--secondary"
            >
              {{- section.settings.button_label_2 | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.highlights != blank -%}
        <ul class="kora-hero__highlights list-unstyled" role="list">
          {%- for highlight in highlights -%}
            {%- assign highlight_text = highlight | strip -%}
            {%- if highlight_text != blank -%}
              <li>{{ highlight_text | escape }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="kora-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '(min-width: 990px) 55vw, 100vw',
            class: 'kora-hero__image',
            loading: 'eager'
        }}
      {%- else -%}
        <img
          src="{{ 'kora-hero.jpg' | asset_url }}"
          alt="{{ section.settings.fallback_alt | escape }}"
          width="1500"
          height="1200"
          class="kora-hero__image"
          loading="eager"
        >
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.show_print_border -%}
    <span class="kora-print-border" aria-hidden="true"></span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Kora hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "Handloom cotton · Hand block-printed"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday cotton, printed by hand."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ],
      "default": "h0"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Kurtas, co-ords and dresses in soft cotton, printed in small batches. Easy to wear, easy to wash, made to last more than one season.</p>"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "First button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "default": "Find your size"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "text",
      "id": "highlights",
      "label": "Highlights",
      "info": "Short points shown under the buttons. Separate them with commas.",
      "default": "Cash on delivery, 7-day exchange, Ships in 2 days"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Landscape works best (about 5:4). Leave empty to use the built-in illustration."
    },
    {
      "type": "text",
      "id": "fallback_alt",
      "label": "Alt text for the built-in illustration",
      "default": "Illustrated flat lay of an indigo block-print kurta, a white palazzo and a rust dupatta"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "show_print_border",
      "label": "Show block-print border",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Kora hero"
    }
  ]
}
{% endschema %}
