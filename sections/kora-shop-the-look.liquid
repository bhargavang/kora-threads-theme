{%- comment -%}
  Shop the look (built from scratch for Kora Threads).

  One styled image with numbered hotspots, next to a numbered list of the
  products in the look and the total price of the full outfit. Tapping a
  hotspot highlights its product in the list (and scrolls to it on phones);
  hovering a product in the list lights up its hotspot.

  Each block is one product plus where its hotspot sits on the image
  (left/top, in % of the image). With no image picked, the section uses
  the illustration in assets, and the default hotspot positions match it.
{%- endcomment -%}
{{ 'section-kora-shop-the-look.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kora-shop-the-look.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign look_total = 0
  assign look_count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign look_total = look_total | plus: block.settings.product.price
      assign look_count = look_count | plus: 1
    endif
  endfor
-%}

<kora-shop-the-look class="kora-look color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="kora-look__grid kora-look__grid--media-{{ section.settings.image_position }}">
      <div class="kora-look__media">
        <div class="kora-look__frame">
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1500
              | image_tag:
                widths: '550, 750, 1100, 1500',
                sizes: '(min-width: 990px) 50vw, 100vw',
                class: 'kora-look__image',
                loading: 'lazy'
            }}
          {%- else -%}
            <img
              src="{{ 'kora-look.jpg' | asset_url }}"
              alt="{{ section.settings.fallback_alt | escape }}"
              width="1200"
              height="1500"
              class="kora-look__image"
              loading="lazy"
            >
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- liquid
              assign look_product = block.settings.product
              if look_product != blank
                assign hotspot_label = look_product.title
              else
                assign hotspot_label = 'Product ' | append: forloop.index
              endif
            -%}
            <button
              type="button"
              class="kora-look__hotspot{% if block.settings.position_x > 60 %} kora-look__hotspot--flip{% endif %}"
              style="--x: {{ block.settings.position_x }}%; --y: {{ block.settings.position_y }}%;"
              aria-controls="KoraLookItem-{{ block.id }}"
              aria-expanded="false"
              data-look-index="{{ forloop.index }}"
            >
              <span class="kora-look__dot" aria-hidden="true">{{ forloop.index }}</span>
              <span class="kora-look__tag">
                <span class="visually-hidden">Show item {{ forloop.index }}:</span>
                {{ hotspot_label | escape }}
              </span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="kora-look__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kora-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="kora-look__heading h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="kora-look__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        <ol class="kora-look__items list-unstyled" role="list">
          {%- for block in section.blocks -%}
            {%- assign look_product = block.settings.product -%}
            <li
              id="KoraLookItem-{{ block.id }}"
              class="kora-look__item"
              data-look-index="{{ forloop.index }}"
              {{ block.shopify_attributes }}
            >
              <span class="kora-look__number" aria-hidden="true">{{ forloop.index }}</span>
              {%- if look_product != blank -%}
                <a href="{{ look_product.url }}" class="kora-look__thumb" tabindex="-1" aria-hidden="true">
                  {%- if look_product.featured_media -%}
                    {{
                      look_product.featured_media
                      | image_url: width: 240
                      | image_tag: widths: '120, 240', sizes: '120px', loading: 'lazy', alt: ''
                    }}
                  {%- endif -%}
                </a>
                <div class="kora-look__info">
                  <a href="{{ look_product.url }}" class="kora-look__title full-unstyled-link">
                    {{- look_product.title | escape -}}
                  </a>
                  {%- render 'price', product: look_product -%}
                  {%- assign colour_option = look_product.options_by_name['Colour'] -%}
                  {%- if colour_option != blank and colour_option.values.size > 1 -%}
                    <p class="kora-look__meta">{{ colour_option.values.size }} colours</p>
                  {%- endif -%}
                </div>
                <a href="{{ look_product.url }}" class="kora-look__view link">
                  View<span class="visually-hidden"> {{ look_product.title | escape }}</span>
                </a>
              {%- else -%}
                <div class="kora-look__thumb kora-look__thumb--empty"></div>
                <div class="kora-look__info">
                  <p class="kora-look__title">Choose a product for this hotspot</p>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>

        {%- if section.settings.show_total and look_count > 1 -%}
          <p class="kora-look__total">
            <span>Full look, {{ look_count }} pieces</span>
            <strong>{{ look_total | money }}</strong>
          </p>
        {%- endif -%}

        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--secondary kora-look__button">
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</kora-shop-the-look>

{% schema %}
{
  "name": "Shop the look",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "Shop the look"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Indigo, white and a dash of rust"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Our block-print kurta with wide cotton palazzos and a kalamkari dupatta. Tap the numbers to see each piece.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Look image",
      "info": "Portrait (4:5) works best. After changing the image, move each product's hotspot to match."
    },
    {
      "type": "text",
      "id": "fallback_alt",
      "label": "Alt text for the built-in illustration",
      "default": "Illustrated flat lay of an indigo block-print kurta, white cotton palazzos and a rust kalamkari dupatta"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_total",
      "label": "Show price of the full look",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See all kurtas"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "look_item",
      "name": "Product hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "position_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Hotspot: distance from left",
          "default": 50
        },
        {
          "type": "range",
          "id": "position_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Hotspot: distance from top",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the look",
      "blocks": [
        { "type": "look_item", "settings": { "position_x": 36, "position_y": 34 } },
        { "type": "look_item", "settings": { "position_x": 72, "position_y": 60 } },
        { "type": "look_item", "settings": { "position_x": 30, "position_y": 84 } }
      ]
    }
  ]
}
{% endschema %}
