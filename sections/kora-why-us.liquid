{%- comment -%}
  "Why shop with us": a short row of reasons, each with an icon.
  Built for small Indian brands, so the default icons cover COD,
  exchanges, WhatsApp support and handmade fabric.
{%- endcomment -%}
{{ 'section-kora-why-us.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="kora-why color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="kora-why__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="kora-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="kora-why__heading h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="kora-why__intro rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="kora-why__list list-unstyled kora-why__list--{{ section.settings.columns_desktop }}-col"
        role="list"
      >
        {%- for block in section.blocks -%}
          <li
            class="kora-why__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <span class="kora-why__icon">{% render 'kora-icon', icon: block.settings.icon, size: 28 %}</span>
            {%- if block.settings.title != blank -%}
              <h3 class="kora-why__title h4">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="kora-why__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Why shop with us",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label above the heading",
      "default": "Why Kora Threads"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made slowly, sent quickly"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro text"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "cotton", "label": "Cotton" },
            { "value": "stamp", "label": "Block-print stamp" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "truck", "label": "Delivery truck" },
            { "value": "cash", "label": "Cash" },
            { "value": "exchange", "label": "Exchange arrows" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "chat", "label": "Chat bubble" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "spool", "label": "Thread spool" }
          ],
          "default": "cotton"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pure cotton"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Breathable cotton, mulmul and khadi. No polyester blends.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why shop with us",
      "blocks": [
        { "type": "reason", "settings": { "icon": "cotton", "title": "Pure cotton" } },
        { "type": "reason", "settings": { "icon": "stamp", "title": "Printed by hand" } },
        { "type": "reason", "settings": { "icon": "cash", "title": "Cash on delivery" } },
        { "type": "reason", "settings": { "icon": "exchange", "title": "Easy exchanges" } }
      ]
    }
  ]
}
{% endschema %}
