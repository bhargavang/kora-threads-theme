{%- comment -%}
  Line icons used across the Kora Threads sections.

  Accepts:
  - icon: {String} cotton, stamp, truck, cash, exchange, whatsapp, ruler,
    leaf, wash, spool, chat
  - size: {Number} pixel size (optional, default 24)

  Usage:
  {% render 'kora-icon', icon: 'truck' %}
{%- endcomment -%}
{%- assign icon_size = size | default: 24 -%}
<svg
  class="kora-icon kora-icon--{{ icon }}"
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {%- case icon -%}
    {%- when 'cotton' -%}
      <path d="M12 21v-7"/>
      <path d="M8 14.5c-2.2 0-3.8-1.6-3.8-3.5 0-1.8 1.4-3.2 3.1-3.3C7.6 5.6 9.6 4 12 4s4.4 1.6 4.7 3.7c1.7.1 3.1 1.5 3.1 3.3 0 1.9-1.6 3.5-3.8 3.5"/>
      <path d="M8 14.5 12 12l4 2.5"/>
      <path d="M12 8v4"/>
    {%- when 'stamp' -%}
      <rect x="4.5" y="13" width="15" height="5" rx="1"/>
      <path d="M9 13v-3h6v3"/>
      <path d="M10.2 10V6a1.8 1.8 0 0 1 3.6 0v4"/>
      <path d="M7 21h10"/>
    {%- when 'truck' -%}
      <path d="M3 6.5h11v9.5H3z"/>
      <path d="M14 9.5h3.8l3.2 3.2V16h-7"/>
      <circle cx="7" cy="17.5" r="1.7"/>
      <circle cx="17" cy="17.5" r="1.7"/>
    {%- when 'cash' -%}
      <rect x="3" y="6.5" width="18" height="11" rx="1.5"/>
      <circle cx="12" cy="12" r="2.6"/>
      <path d="M6.5 9.5h.01M17.5 14.5h.01"/>
    {%- when 'exchange' -%}
      <path d="M4 9h14l-3.5-3.5"/>
      <path d="M20 15H6l3.5 3.5"/>
    {%- when 'whatsapp' -%}
      <path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.5-4.2a8.5 8.5 0 1 1 15.5-4.6Z"/>
      <path d="M9 8.3c.3-.4.6-.5 1-.5h.3c.2 0 .4.1.5.4l.7 1.6c.1.3 0 .5-.1.7l-.6.7c.5 1 1.3 1.8 2.3 2.3l.7-.6c.2-.2.5-.2.7-.1l1.6.7c.3.1.4.3.4.5v.3c0 .4-.2.7-.5 1-.7.5-1.7.6-2.6.2a8.6 8.6 0 0 1-4.1-4.1c-.4-.9-.3-1.9.2-2.9Z"/>
    {%- when 'chat' -%}
      <path d="M4 5.5h16v10H9l-5 4z"/>
      <path d="M8 9.5h8M8 12.5h5"/>
    {%- when 'ruler' -%}
      <rect x="2.5" y="8" width="19" height="8" rx="1"/>
      <path d="M6 8v3M9.5 8v2M13 8v3M16.5 8v2"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5.3-13.2 14-14-.8 8.8-6 14-14 14Z"/>
      <path d="M5 19l8-8"/>
    {%- when 'wash' -%}
      <path d="M3 7.5 5 19h14l2-11.5"/>
      <path d="M3 7.5c1.5 1.2 3 1.2 4.5 0s3-1.2 4.5 0 3 1.2 4.5 0 3-1.2 4.5 0"/>
    {%- when 'spool' -%}
      <rect x="6" y="3" width="12" height="3" rx="1"/>
      <rect x="6" y="18" width="12" height="3" rx="1"/>
      <path d="M8 6v12M16 6v12M8 9l8 2.2M8 12.8l8 2.2"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
